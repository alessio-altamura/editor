{
  "name": "doc-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime da riga di comando: legge la cartella di un documento e scrive il resolved tree",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "doc-runtime": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node dist/test/conformance-suite.js && node dist/test/robustness-suite.js"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "micromark-util-types": "2.0.3",
    "typescript": "5.9.3"
  }
}
