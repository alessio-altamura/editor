{
  "name": "doc-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime da riga di comando: legge la cartella di un documento, scrive il resolved tree, l'HTML e il PDF",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "doc-runtime": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node dist/test/conformance-suite.js && node dist/test/robustness-suite.js && node dist/test/export-suite.js",
    "test:browser": "tsc -p . && node dist/test/browser-suite.js && node dist/test/print-suite.js"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "morphdom": "2.7.8",
    "playwright-core": "1.56.1",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "html-validate": "11.16.2",
    "micromark-util-types": "2.0.3",
    "parse5": "8.0.1",
    "typescript": "5.9.3"
  }
}
